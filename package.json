{
  "name": "stock-monitor",
  "version": "2.0.0",
  "description": "股票期货实时监控助手 - 实时监控、语音播报、价格提醒、涨停看板、走势图",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "lint:fix": "eslint src tests --fix",
    "test": "qunit --require ./tests/_jsdom-setup.cjs \"tests/**/*.test.js\"",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "ci": "npm run lint && npm run test && npm run e2e && npm run build"
  },
  "dependencies": {
    "lightweight-charts": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.1.3",
    "qunit": "^2.20.0",
    "terser": "^5.36.0",
    "vite": "^5.4.0"
  }
}
